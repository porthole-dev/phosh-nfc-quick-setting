<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <template class="PhoshNfcQuickSetting" parent="PhoshQuickSetting">
    <property name="status-icon">info</property>
    <property name="status-page">status_page</property>
    <signal name="clicked" handler="on_clicked" object="PhoshNfcQuickSetting" swapped="yes"/>
  </template>
  <object class="PhoshStatusIcon" id="info">
    <property name="visible">1</property>
    <property name="pixel-size">16</property>
  </object>
  <object class="PhoshStatusPage" id="status_page">
    <property name="visible">1</property>
    <property name="title" translatable="yes">NFC</property>
    <property name="content">placeholder</property>
    <property name="footer">footer</property>
  </object>
  <object class="PhoshStatusPagePlaceholder" id="placeholder">
    <property name="visible">1</property>
    <property name="icon-name">nfc-disabled-quick-setting-symbolic</property>
    <property name="title" translatable="yes">NFC Off</property>
  </object>
  <object class="GtkButton" id="footer">
    <property name="visible">1</property>
    <property name="hexpand">1</property>
    <property name="focus-on-click">0</property>
    <property name="action-name">panel.launch-panel</property>
    <property name="action-target">(&quot;privacy&quot;, [&lt;&quot;nfc&quot;&gt;])</property>
    <child>
      <object class="GtkLabel">
        <property name="visible">1</property>
        <property name="ellipsize">end</property>
        <property name="label" translatable="yes">NFC Settings</property>
      </object>
    </child>
  </object>
</interface>
